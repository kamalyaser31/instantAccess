#. Translators: Announcement of a browsed item as "shortcut, name", e.g. "g, Open Gmail".
#: addon\globalPlugins\core\browse.py:65
#, python-brace-format
msgid "{key}, {name}"
msgstr "{key}، {name}"

#. Translators: Announcement of a browsed item as "name, shortcut", e.g. "Open Gmail, g".
#: addon\globalPlugins\core\browse.py:67
#, python-brace-format
msgid "{name}, {key}"
msgstr "{name}، {key}"

#. Translators: Title of the dialog used to select an NVDA command.
#: addon\globalPlugins\core\command_picker_dialog.py:25
msgid "Select NVDA command"
msgstr "حدد اختصار nvda"

#. Translators: Label for filter field in NVDA command selection dialog.
#: addon\globalPlugins\core\command_picker_dialog.py:42
msgid "Filter"
msgstr "تصفية"

#. Translators: Label for OK button in NVDA command selection dialog.
#. Translators: OK button of the action dialog.
#. Translators: OK button of the item dialog.
#: addon\globalPlugins\core\command_picker_dialog.py:51
#: addon\globalPlugins\core\item_dialog.py:318
#: addon\globalPlugins\core\item_dialog.py:679
msgid "&OK"
msgstr "&موافق"

#. Translators: Label for Cancel button in NVDA command selection dialog.
#. Translators: Button to cancel and close the dialog without running anything.
#. Translators: Cancel button of the action dialog.
#. Translators: Cancel button of the item dialog.
#: addon\globalPlugins\core\command_picker_dialog.py:53
#: addon\globalPlugins\core\help_dialog.py:41
#: addon\globalPlugins\core\item_dialog.py:320
#: addon\globalPlugins\core\item_dialog.py:681
#: addon\globalPlugins\core\settings_panel.py:446
msgid "&Cancel"
msgstr "إل&غاء"

#. Translators: Error shown when OK is pressed without choosing an NVDA command.
#: addon\globalPlugins\core\command_picker_dialog.py:264
msgid "Please select an NVDA command."
msgstr "من فضلك حدد اختصار nvda."

#: addon\globalPlugins\core\config_io.py:232
msgid ""
"The instant Access configuration file appears to be corrupted. Would you "
"like to restore the previous backup?"
msgstr ""
"يبدو أن ملف تهيئة الوصول الفوري تالف. هل ترغب في استعادة النسخة الاحتياطية "
"السابقة؟"

#. Translators: Action type that opens a website or URI.
#: addon\globalPlugins\core\constants.py:12
msgid "Website"
msgstr "موقع ويب"

#. Translators: Action type that starts a program.
#: addon\globalPlugins\core\constants.py:14
msgid "Program"
msgstr "برنامج"

#. Translators: Action type that opens a folder.
#: addon\globalPlugins\core\constants.py:16
msgid "Folder"
msgstr "مجلد"

#. Translators: Action type that opens a file.
#: addon\globalPlugins\core\constants.py:18
msgid "File"
msgstr "ملف"

#. Translators: Action type that runs an NVDA command.
#. Translators: Label of the read-only field showing the chosen NVDA command.
#: addon\globalPlugins\core\constants.py:20
#: addon\globalPlugins\core\item_dialog.py:268
msgid "NVDA command"
msgstr "اختصار nvda"

#. Translators: Action type that types, copies or pastes text.
#. Translators: Label of the text snippet field.
#: addon\globalPlugins\core\constants.py:22
#: addon\globalPlugins\core\item_dialog.py:278
#: addon\globalPlugins\core\item_dialog.py:395
msgid "Text snippet"
msgstr "نص"

#. Translators: Action type that sends a sequence of key presses.
#: addon\globalPlugins\core\constants.py:24
msgid "Keystrokes"
msgstr "ضغطات مفاتيح"

#. Translators: Action labels for text snippet entries.
#: addon\globalPlugins\core\constants.py:43
msgid "Type the text"
msgstr "اكتب النص"

#: addon\globalPlugins\core\constants.py:43
msgid "Copy"
msgstr "نسخ"

#: addon\globalPlugins\core\constants.py:43
msgid "Paste"
msgstr "لصق"

#. Translators: Category name for the instant Access add-on.
#. Translators: Title of the instant Access settings panel.
#: addon\globalPlugins\core\constants.py:50
#: addon\globalPlugins\core\settings_panel.py:83 buildVars.py:12
msgid "instant Access"
msgstr "الوصول الفوري"

#. Translators: Description for the toggle instant mode command in Input Gestures.
#: addon\globalPlugins\core\constants.py:53
msgid "Toggle instant Access mode."
msgstr "تبديل وضع الوصول الفوري."

#. Translators: Description for reporting the currently focused application name.
#: addon\globalPlugins\core\constants.py:56
msgid "Report current app name."
msgstr "الإبلاغ عن اسم التطبيق الحالي."

#. Translators: Caption for error message dialogs.
#: addon\globalPlugins\core\constants.py:65
msgid "Error"
msgstr "خطأ"

#. Translators: Caption for confirmation dialogs.
#. Translators: Title of the question before deleting an action.
#: addon\globalPlugins\core\constants.py:68
#: addon\globalPlugins\core\item_dialog.py:827
msgid "Confirm"
msgstr "تأكيد"

#. Translators: Label for beginner verbosity level.
#: addon\globalPlugins\core\constants.py:73
msgid "Beginner"
msgstr "مبتدئ"

#. Translators: Label for advanced verbosity level.
#: addon\globalPlugins\core\constants.py:76
msgid "Advanced"
msgstr "متقدم"

#. Translators: Choices for how items are announced while browsing the instant Access layer.
#: addon\globalPlugins\core\constants.py:83
msgid "Name, then shortcut"
msgstr "الاسم ثم الاختصار"

#: addon\globalPlugins\core\constants.py:83
msgid "Shortcut, then name"
msgstr "الاختصار ثم الاسم"

#: addon\globalPlugins\core\constants.py:83
msgid "Name only"
msgstr "الاسم فقط"

#. Translators: Choices for the order of items while browsing the instant Access layer.
#: addon\globalPlugins\core\constants.py:88
msgid "Settings list order"
msgstr "ترتيب قائمة الإعدادات"

#: addon\globalPlugins\core\constants.py:88
msgid "Alphabetical by name"
msgstr "أبجدياً حسب الاسم"

#: addon\globalPlugins\core\constants.py:88
msgid "By shortcut"
msgstr "حسب الاختصار"

#. Translators: Choices for whether one item speaks its name when it runs.
#: addon\globalPlugins\core\constants.py:94
msgid "Use the general setting"
msgstr "اتباع الإعداد العام"

#: addon\globalPlugins\core\constants.py:94
msgid "Announce"
msgstr "النطق"

#: addon\globalPlugins\core\constants.py:94
msgid "Do not announce"
msgstr "عدم النطق"

#. Translators: Announced when too many items are queued to run.
#: addon\globalPlugins\core\executor.py:132
msgid "Too many items are waiting. Please try again later."
msgstr "هناك عناصر كثيرة قيد الانتظار. يرجى المحاولة لاحقاً."

#. Translators: Announced when an item stopped because of an unexpected error.
#: addon\globalPlugins\core\executor.py:161
msgid "Error: Could not run the item"
msgstr "خطأ: تعذر تشغيل العنصر"

#. Translators: Announced when an NVDA command action takes too long.
#: addon\globalPlugins\core\executor.py:219
msgid "Error: NVDA command did not finish in time"
msgstr "خطأ: لم ينتهِ أمر NVDA في الوقت المحدد"

#. Translators: Announced when a stored typing delay is invalid.
#. Translators: Error shown when the typing delay is not a number.
#: addon\globalPlugins\core\executor.py:287
#: addon\globalPlugins\core\item_dialog.py:534
msgid "Typing delay must be a valid number."
msgstr "يجب أن يكون رقمًا صالحًا."

#. Translators: Announced when a text snippet action has no text.
#: addon\globalPlugins\core\executor.py:293
msgid "Error: Text snippet is empty"
msgstr "حقل النص فارغ"

#. Translators: Announced when the snippet text could not be copied to the clipboard.
#. Translators: Announced when the snippet text could not be copied before pasting.
#: addon\globalPlugins\core\executor.py:299
#: addon\globalPlugins\core\executor.py:311
msgid "Error: Could not copy text snippet"
msgstr "خطأ: تعذر نسخ النص"

#. Translators: Announced when simulated key presses are unavailable.
#. Translators: Announced when simulated typing is unavailable.
#. Translators: Announced when simulated keystrokes are unavailable.
#: addon\globalPlugins\core\executor.py:306
#: addon\globalPlugins\core\executor.py:333
#: addon\globalPlugins\core\executor.py:443
msgid "Error: Keyboard library is not available"
msgstr "خطأ: مكتبة لوحة المفاتيح غير مثبتة"

#. Translators: Announced when pasting a snippet failed.
#: addon\globalPlugins\core\executor.py:324
msgid "Error: Could not paste text snippet"
msgstr "خطأ: تعذر لصق النص"

#. Translators: Announced when the text copied before a paste could not be put back.
#: addon\globalPlugins\core\executor.py:329
msgid "Error: Could not restore the clipboard"
msgstr "خطأ: تعذرت استعادة الحافظة"

#. Translators: Announced when typing a snippet failed.
#: addon\globalPlugins\core\executor.py:340
msgid "Error: Could not type text snippet"
msgstr "خطأ: تعذر كتابة النص"

#. Translators: Announced when a key press failed. {key} is the key name, for example ctrl+c.
#: addon\globalPlugins\core\executor.py:389
#, python-brace-format
msgid "Error: Could not send keystroke: {key}"
msgstr "خطأ: تعذر إرسال ضغطة المفتاح: {key}"

#. Translators: Announced when a website action has no address.
#: addon\globalPlugins\core\executor.py:417
msgid "Error: URL is empty"
msgstr "خطأ: الرابط فارغ"

#. Translators: Announced when the browser could not open the address.
#. Translators: Announced when opening the address raised an error.
#: addon\globalPlugins\core\executor.py:425
#: addon\globalPlugins\core\executor.py:430
msgid "Error: Could not open the website"
msgstr "خطأ: تعذر فتح الموقع"

#. Translators: Announced when a keystrokes action has no keys.
#: addon\globalPlugins\core\executor.py:448
msgid "Error: Keystrokes field is empty"
msgstr "خطأ: حقل ضغطات المفاتيح فارغ"

#. Translators: Announced when the path of an action is empty.
#. Translators: Announced when the folder or file of an action does not exist.
#. Translators: Announced when a program does not exist and is not on the PATH.
#: addon\globalPlugins\core\executor.py:455
#: addon\globalPlugins\core\executor.py:461
#: addon\globalPlugins\core\executor.py:483
msgid "Error: File not found"
msgstr "خطأ: الملف غير موجود"

#. Translators: Announced when a folder could not be opened.
#: addon\globalPlugins\core\executor.py:470
msgid "Error: Could not open the item"
msgstr "خطأ: تعذر فتح العنصر"

#. Translators: Announced when a file could not be opened.
#: addon\globalPlugins\core\executor.py:473
msgid "Error: Could not open the file"
msgstr "خطأ: تعذر فتح الملف"

#. Translators: Announced when the user declines the Windows administrator prompt.
#. Translators: Announced when NVDA+E stops a running item.
#: addon\globalPlugins\core\executor.py:512
#: addon\globalPlugins\core\plugin.py:285
msgid "Cancelled"
msgstr "ملغى"

#. Translators: Announced when a program failed to start.
#: addon\globalPlugins\core\executor.py:516
msgid "Error: Could not start the program"
msgstr "خطأ: تعذر تشغيل البرنامج"

#. Translators: Announced when the stored interval between actions is invalid.
#. Translators: Error shown when the interval between actions is not a number.
#: addon\globalPlugins\core\executor.py:537
#: addon\globalPlugins\core\item_dialog.py:922
msgid "Interval must be a valid number."
msgstr "يجب أن يكون الفاصل الزمني رقمًا صالحًا."

#. Translators: Announced when an action raised an unexpected error.
#: addon\globalPlugins\core\executor.py:552
msgid "Error: Could not run the action"
msgstr "خطأ: تعذر تشغيل الإجراء"

#: addon\globalPlugins\core\help_dialog.py:17
msgid "instant Access items"
msgstr "عناصر الوصول الفوري"

#. Translators: Label for filter field in instant Access help dialog.
#: addon\globalPlugins\core\help_dialog.py:29
msgid "&Filter:"
msgstr "&تصفية:"

#. Translators: Label for items list in instant Access help dialog.
#: addon\globalPlugins\core\help_dialog.py:32
msgid "&Items:"
msgstr "ال&عناصر:"

#. Translators: Button to run the selected instant Access item.
#: addon\globalPlugins\core\help_dialog.py:39
msgid "&Run"
msgstr "ت&شغيل"

#. Translators: Summary of a text snippet action, e.g. "Paste: Hello".
#: addon\globalPlugins\core\item_dialog.py:80
#, python-brace-format
msgid "{action}: {preview}"
msgstr "{action}: {preview}"

#: addon\globalPlugins\core\item_dialog.py:137
msgid ""
"Keystrokes or text typing will be simulated after a 3-second delay so you "
"can switch to the target window.\n"
"\n"
"Would you like to proceed?"
msgstr ""
"سيتم إجراء محاكاة ضغطات المفاتيح أو كتابة النص بعد مهلة قدرها 3 ثوانٍ لتتمكن "
"من الانتقال إلى النافذة المستهدفة.\n"
"\n"
"هل ترغب في المتابعة؟"

#. Translators: Title of the dialog that captures an item's shortcut.
#: addon\globalPlugins\core\item_dialog.py:146
msgid "Set shortcut"
msgstr "تعيين اختصار"

#. Translators: Instruction in the shortcut capture dialog.
#: addon\globalPlugins\core\item_dialog.py:150
msgid "Press the desired shortcut key. Escape cancels."
msgstr "اضغط على مفتاح الاختصار المطلوب. اضغط Escape للإلغاء."

#. Translators: Title of the dialog that records keys for a keystrokes action.
#: addon\globalPlugins\core\item_dialog.py:172
msgid "Record keystrokes"
msgstr "تسجيل ضغطات المفاتيح"

#. Translators: Instruction in the dialog that records keys for a keystrokes action.
#: addon\globalPlugins\core\item_dialog.py:178
msgid "Press the keys to record. Escape finishes."
msgstr "اضغط المفاتيح التي تريد تسجيلها، ثم Escape للإنهاء."

#. Translators: Error shown when a captured key cannot be sent by a keystrokes action.
#. Translators: Error shown when the captured key is not a valid NVDA gesture.
#. Translators: Error shown when the item's shortcut is not a valid NVDA gesture.
#: addon\globalPlugins\core\item_dialog.py:219
#: addon\globalPlugins\core\item_dialog.py:890
#: addon\globalPlugins\core\item_dialog.py:940
msgid "Invalid shortcut key."
msgstr "مفتاح الاختصار غير صالح."

#. Translators: Label of the action type choice.
#. Translators: Column header for the action type.
#. Translators: Column label for item type in the list.
#: addon\globalPlugins\core\item_dialog.py:234
#: addon\globalPlugins\core\item_dialog.py:614
#: addon\globalPlugins\core\settings_panel.py:102
msgid "Type"
msgstr "النوع"

#. Translators: Label of the path or URL field in the action dialog.
#: addon\globalPlugins\core\item_dialog.py:240
msgid "Path or URL"
msgstr "المسار أو الرابط"

#. Translators: Button that opens a file or folder chooser for the action path.
#: addon\globalPlugins\core\item_dialog.py:243
msgid "Browse"
msgstr "تصفح"

#. Translators: Button to open a menu of variables to insert into the path or URL field.
#. Translators: Button to open a menu of variables to insert into the arguments field.
#. Translators: Button to open a menu of variables to insert into the snippet field.
#: addon\globalPlugins\core\item_dialog.py:246
#: addon\globalPlugins\core\item_dialog.py:257
#: addon\globalPlugins\core\item_dialog.py:286
msgid "Insert &variable…"
msgstr "إدراج م&تغير…"

#. Translators: Label of the optional command line arguments field.
#: addon\globalPlugins\core\item_dialog.py:253
msgid "Arguments (optional)"
msgstr "الوسائط (اختياري)"

#. Translators: Checkbox that starts a program with administrator rights.
#: addon\globalPlugins\core\item_dialog.py:262
msgid "Run as &administrator"
msgstr "التشغيل م&سؤولاً"

#. Translators: Button that opens the NVDA command picker.
#: addon\globalPlugins\core\item_dialog.py:271
msgid "Select command"
msgstr "اختر أمرًا"

#. Translators: Button that captures a key press and adds it to the keystrokes field.
#: addon\globalPlugins\core\item_dialog.py:281
msgid "Add keystroke"
msgstr "إضافة ضغطة"

#. Translators: Label of the choice between typing, copying and pasting a snippet.
#: addon\globalPlugins\core\item_dialog.py:293
msgid "Snippet action"
msgstr "إجراء النص"

#. Translators: Label of the delay between typed characters.
#: addon\globalPlugins\core\item_dialog.py:302
#: addon\globalPlugins\core\item_dialog.py:397
msgid "Typing delay"
msgstr "الفاصل بين الحروف بالثواني"

#. Translators: Label of the delay before this action runs.
#: addon\globalPlugins\core\item_dialog.py:311
msgid "Delay before executing this action (seconds)"
msgstr "مدة التأخير قبل تنفيذ هذا الإجراء (ثواني)"

#. Translators: Button that runs only this action, to try it.
#. Translators: Label for the Test button in the settings panel.
#: addon\globalPlugins\core\item_dialog.py:322
#: addon\globalPlugins\core\settings_panel.py:119
msgid "&Test"
msgstr "تج&ربة"

#. Translators: Label of the keystrokes field; one key or shortcut per line.
#: addon\globalPlugins\core\item_dialog.py:390
msgid "Keystrokes (one per line, e.g. 'down 5')"
msgstr "ضغطات المفاتيح (واحدة في كل سطر، مثل: down 5)"

#. Translators: Label of the delay between simulated key presses.
#: addon\globalPlugins\core\item_dialog.py:392
msgid "Delay between keystrokes (seconds)"
msgstr "الفاصل بين الضغطات (ثواني)"

#. Translators: Menu item to insert the {date} variable into the text field.
#: addon\globalPlugins\core\item_dialog.py:417
msgid "&Date"
msgstr "ال&تاريخ"

#. Translators: Menu item to insert the {time} variable into the text field.
#: addon\globalPlugins\core\item_dialog.py:419
msgid "&Time"
msgstr "ال&وقت"

#. Translators: Menu item to insert the {clipboard} variable into the text field.
#: addon\globalPlugins\core\item_dialog.py:421
msgid "&Clipboard text"
msgstr "نص ال&حافظة"

#. Translators: Menu item to insert the {selection} variable into the text field.
#: addon\globalPlugins\core\item_dialog.py:423
msgid "&Selected text"
msgstr "&النص المحدد"

#. Translators: Menu item to insert the {file} variable into the text field.
#: addon\globalPlugins\core\item_dialog.py:425
msgid "Selected &file (File Explorer)"
msgstr "ال&ملف المحدد (مستكشف الملفات)"

#. Translators: Menu item to insert the {folder} variable into the text field.
#: addon\globalPlugins\core\item_dialog.py:427
msgid "Open f&older (File Explorer)"
msgstr "الم&جلد المفتوح (مستكشف الملفات)"

#. Translators: Title of the folder chooser.
#: addon\globalPlugins\core\item_dialog.py:453
msgid "Select a folder"
msgstr "اختر مجلدًا"

#. Translators: Titles of the program and file choosers.
#: addon\globalPlugins\core\item_dialog.py:456
msgid "Select a program"
msgstr "اختر برنامجًا"

#: addon\globalPlugins\core\item_dialog.py:456
msgid "Select a file"
msgstr "اختر ملفًا"

#. Translators: Error shown when the action's main field is empty.
#. Translators: Error shown when the item has no name or no shortcut.
#: addon\globalPlugins\core\item_dialog.py:500
#: addon\globalPlugins\core\item_dialog.py:904
msgid "All fields are required."
msgstr "كافة الحقول مطلوبة."

#: addon\globalPlugins\core\item_dialog.py:511
#, python-brace-format
msgid ""
"The specified path was not found on your system:\n"
"{path}\n"
"\n"
"Would you like to save this action anyway?"
msgstr ""
"لم يتم العثور على المسار المحدد في نظامك:\n"
"{path}\n"
"\n"
"هل ترغب في حفظ هذا الإجراء على أية حال؟"

#. Translators: Error shown when the action delay is not a number.
#: addon\globalPlugins\core\item_dialog.py:520
msgid "Delay must be a valid number."
msgstr "يجب أن يكون رقمًا صالحًا."

#. Translators: Error shown when the action delay is negative.
#: addon\globalPlugins\core\item_dialog.py:522
msgid "Delay must be zero or greater."
msgstr "يجب أن يكون رقمًا صالحًا."

#. Translators: Error shown when the typing delay is negative.
#: addon\globalPlugins\core\item_dialog.py:536
msgid "Typing delay must be zero or greater."
msgstr "يجب أن يكون تأخير الكتابة رقمًا صالحًا."

#. Translators: Error shown when the keystroke delay is not a number.
#: addon\globalPlugins\core\item_dialog.py:547
msgid "Delay between keystrokes must be a valid number."
msgstr "يجب أن يكون الفاصل رقمًا صالحًا."

#. Translators: Error shown when the keystroke delay is negative.
#: addon\globalPlugins\core\item_dialog.py:549
msgid "Delay between keystrokes must be zero or greater."
msgstr "يجب أن يكون الفاصل صفرًا أو أكبر."

#. Translators: Label of the item name field.
#. Translators: Column label for item name in the list.
#: addon\globalPlugins\core\item_dialog.py:604
#: addon\globalPlugins\core\settings_panel.py:100
msgid "Name"
msgstr "الاسم"

#. Translators: Label of the item's action list.
#: addon\globalPlugins\core\item_dialog.py:607
msgid "Actions"
msgstr "الإجراءات"

#. Translators: Column header for the delay before an action.
#: addon\globalPlugins\core\item_dialog.py:616
msgid "Delay"
msgstr "التأخير"

#. Translators: Column header for the action details.
#. Translators: Column label for details in the list.
#: addon\globalPlugins\core\item_dialog.py:618
#: addon\globalPlugins\core\settings_panel.py:106
msgid "Details"
msgstr "تفاصيل"

#. Translators: Button that adds an action.
#. Translators: Label for the Add button in the settings panel.
#: addon\globalPlugins\core\item_dialog.py:623
#: addon\globalPlugins\core\settings_panel.py:111
msgid "&Add"
msgstr "إ&ضافة"

#. Translators: Button that edits the selected action.
#. Translators: Label for the Edit button in the settings panel.
#: addon\globalPlugins\core\item_dialog.py:625
#: addon\globalPlugins\core\settings_panel.py:113
msgid "&Edit"
msgstr "&تحرير"

#. Translators: Button that deletes the selected action.
#. Translators: Label for the Delete button in the settings panel.
#: addon\globalPlugins\core\item_dialog.py:627
#: addon\globalPlugins\core\settings_panel.py:115
msgid "&Delete"
msgstr "&حذف"

#. Translators: Button that moves the selected action up.
#: addon\globalPlugins\core\item_dialog.py:629
msgid "Move &up"
msgstr "نقل لل&أعلى"

#. Translators: Button that moves the selected action down.
#: addon\globalPlugins\core\item_dialog.py:631
msgid "Move do&wn"
msgstr "نقل للأ&سفل"

#. Translators: Label of the pause between the item's actions.
#: addon\globalPlugins\core\item_dialog.py:636
